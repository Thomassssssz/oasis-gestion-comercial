# Plantilla de variables de entorno para la base de datos de desarrollo.
# Copiá este archivo como ".env" y reemplazá los valores.
# El archivo ".env" NUNCA se sube a GitHub.

POSTGRES_USER=oasis
# Elegí tu propia contraseña. No uses una real de otros servicios.
POSTGRES_PASSWORD=cambiar_esta_contrasena
POSTGRES_DB=oasis
POSTGRES_PORT=5432
