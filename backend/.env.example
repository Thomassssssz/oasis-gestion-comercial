# Plantilla de variables de entorno del backend.
# Copiá este archivo como ".env" y reemplazá los valores.
# El archivo ".env" NUNCA se sube a GitHub.

# Base de desarrollo. Usá el mismo usuario, contraseña y puerto del .env de la raíz (el de Docker).
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/oasis"

# Base separada SOLO para las pruebas automáticas. Las pruebas borran sus datos,
# por eso el nombre de la base tiene que terminar en "_test".
TEST_DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/oasis_test"
